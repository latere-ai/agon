# Agon landing site (agon.latere.ai). Built by `make release` locally
# (no longer by GH Actions). Separate from the `agon` CLI release
# (goreleaser).
#
# Both build stages pin --platform=$BUILDPLATFORM so they run native on the
# host (avoids the bun x86_64-under-qemu SIGILL crash on Apple Silicon).
# The frontend dist is arch-neutral static files; the Go binary is
# cross-compiled to TARGETOS/TARGETARCH so the final amd64 image runs
# correctly on cluster nodes.

FROM --platform=$BUILDPLATFORM oven/bun:1-alpine AS frontend
WORKDIR /src
COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile
COPY frontend/ ./
RUN bun run build

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN rm -rf internal/web/spa/dist
COPY --from=frontend /src/dist internal/web/spa/dist/
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION}" \
    -o /agon-web ./cmd/agon-web

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /agon-web /agon-web
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/agon-web"]
CMD ["-addr", ":8080"]
